    "independent": {
      "source": "hand calculation: 300 kN total tension / 2 symmetric anchors",
      "T": [
        150,
        150
      ],
      "qx": [
        0,
        0
      ],
      "qy": [
        0,
        0
      ],
      "tolPct": 0.01
    }
  },
